#include <stdio.h>

int fib_recursive(int n) {
    if (n == 1 || n == 2) {
        return n - 1; 
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

int main() {
    int n = 10;
    printf("%dth term of Fibonacci series = %d\n", n, fib_recursive(n));
    return 0;
}
#include <stdio.h>

int fib_iterative(int n) {
    if (n == 1 || n == 2) {
        return n - 1; 
    }
    return fib_iterative(n - 1) + fib_iterative(n - 2);
}

int main() {
    int n = 42;
    printf("%dth term of Fibonacci series = %d\n", n, fib_iterative(n));
    return 0;
}
