#include <stdio.h>

int main() {
    int rollno;
    char nameinitial;
    float marks1,marks2,marks3,total,average;
    char grade;
    // input
    printf("Enter roll no.:");
    scanf("%d", &rollno);
    printf("Enter name initial.:");
    scanf("%c", &nameinitial);
    printf("Enter marks in subject 1.:");
    scanf("%f", &marks1);
    printf("Enter marks in subject 2.:");
    scanf("%f", &marks2);
    printf("Enter marks in subject 3.:");
    scanf("%f", &marks3);
    // calulation
    total = marks1 + marks2 + marks3;
    average = total/3;
    // grade calculation
    if (average >= 90)
        grade ='A';
    else if (average >= 75)
        grade ='B';
    else if (average >= 60)
        grade ='C';
    else if (average >= 40)
        grade ='D';
    else
        grade = 'F';
    // output
    printf("\n___________ STUDENT MARKSHEET__________");
    printf("Roll no: %d\n", rollno);
    printf("Name initial: %c\n", nameinitial);
    printf("Total marks: %2f\n", total);
    printf("average marks: %2f\n", average);
    printf("Grade: %c\n", grade);}
