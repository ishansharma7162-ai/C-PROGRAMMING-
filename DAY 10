#include <stdio.h>
int sumNatural(int n);
int main() {
    int num;
    printf("Enter the no. (n): ");
    scanf("%d", &num);
    int result = sumNatural(num);
    printf("First %d natural numbers sum: %d\n", num, result);
    return 0;
}
int sumNatural(int n) {
    if (n == 1) {
        return 1;
    }
    return n + sumNatural(n - 1);
}
