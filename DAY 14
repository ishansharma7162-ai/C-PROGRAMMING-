include <stdio.h>

int main() {
    int a = 34;
    int *ptr = &a;

    printf("ptr address: %p\n", ptr);
    printf("ptr + 1 address: %p\n", ptr + 1); 

    int arr[] = {10, 20, 30, 40};
    printf("arr[0] address: %p | arr: %p\n", &arr[0], arr);
    printf("arr[1] address: %p | arr + 1: %p\n", &arr[1], arr + 1);
    printf("arr[1] value: %d | *(arr + 1): %d\n", arr[1], *(arr + 1));

    return 0;
}
