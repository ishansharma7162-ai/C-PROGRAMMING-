#include <stdio.h>

int main() {
    int age;
    printf("Apni age daalo: ");
    scanf("%d", &age);

    if (age >= 60) {
        printf("Aap Senior Citizen hain.\n");
    }
    else if (age >= 18) {
        printf("Aap Adult hain.\n");
    }
    else {
        printf("Aap Child/Teenager hain.\n");
    }

    return 0;
}
