#include <stdio.h>
void swap(int *a,int *b);
int main(){
    int x = 10,y = 20;
    printf("before swap:x = %d,y = %d\n",x,y);
    swap(&x,&y);
    printf("after swap:x = %d,y = %d\n",x,y);
    return 0;
}
void swap(int *a, int *b){
    int temp = *a;
    *a = *b;
    temp = *b;
    printf("values are swap in the function!\n");
}
