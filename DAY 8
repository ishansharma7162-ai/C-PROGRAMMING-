#include <stdio.h>
int main(){
    int a = 100;
    int b = 3;
    printf("Normal division (int / int): %d / %d = %d\n",a,b,a / b);
    float result = (float) a / b;
    printf("typecasted division: %f\n",result);
    return 0;
}
#include <stdio.h>
int main(){
    int i,n;
    printf("n:");
    scanf("%d",&n);
    for(int i = 10;i >= 1;i--){
        printf("%d x %d: %d\n",n,i,n * i);
    }
    return 0;
} 
