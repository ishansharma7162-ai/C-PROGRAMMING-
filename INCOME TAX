#include <stdio.h>

int main() {
    float income, tax = 0;
    printf("Enter your annual income (in Lakhs): ");
    scanf("%f", &income);

    if (income <= 2.5) {
        tax = 0;
    } 
    else if (income > 2.5 && income <= 5.0) {
        tax = 0.05 * (income - 2.5);
    } 
    else if (income > 5.0 && income <= 10.0) {
        tax = 0.05 * (5.0 - 2.5) + 0.20 * (income - 5.0);
    } 
    else {
        tax = 0.05 * (5.0 - 2.5) + 0.20 * (10.0 - 5.0) + 0.30 * (income - 10.0);
    }

    printf("Your annual tax: %f Lakhs\n", tax);
    return 0;
}
