#include <stdio.h>

int main() {
    int n;
    printf("Enter the no. that you want to print table: ");
    scanf("%d", &n);

    // Loop 1 se 10 tak chalega
    for (int i = 1; i <= 10; i++) {
        printf("%d x %d = %d\n", n, i, n * i);
    }

    return 0;
}
#include <stdio.h>

int main() {
    int n;
    printf("Enter the no. that you want to print table: ");
    scanf("%d", &n);

    // Loop 10 se 1 tak chalega
    for (int i = 10; i >= 1; i--) {
        printf("%d x %d = %d\n", n, i, n * i);
    }

    return 0;
}
#include <stdio.h>

int main() {
    int n;
    int sum = 0; 

    printf("Enter the value of n : ");
    scanf("%d", &n); 
    for (int i = 1; i <= n; i++) {
        sum = sum + i; 
    }
    printf("Sum of first %d natural numbers is: %d\n", n, sum);

    return 0;
}
