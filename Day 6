#include <stdio.h>

int main() {
    int num;
    printf("Number enter karo: ");
    scanf("%d", &num);

    // Remainder 0 aane par divisible hota hai
    printf("Divisibility test result (0 means Not Divisible, 1 means Divisible): %d\n", num % 97 == 0);

    return 0;
}
#include <stdio.h>

int main() {
    int num;

    // User se input lene ke liye
    printf("Enter the number you want multiplication table of:\n");
    scanf("%d", &num);

    printf("Table of %d:\n", num);

    // Multiplication table print karna (1 se 10 tak)
    printf("%d * 1 = %d\n", num, num * 1);
    printf("%d * 2 = %d\n", num, num * 2);
    printf("%d * 3 = %d\n", num, num * 3);
    printf("%d * 4 = %d\n", num, num * 4);
    printf("%d * 5 = %d\n", num, num * 5);
    printf("%d * 6 = %d\n", num, num * 6);
    printf("%d * 7 = %d\n", num, num * 7);
    printf("%d * 8 = %d\n", num, num * 8);
    printf("%d * 9 = %d\n", num, num * 9);
    printf("%d * 10 = %d\n", num, num * 10);

    return 0;
}
